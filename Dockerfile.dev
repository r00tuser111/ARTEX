# syntax=docker/dockerfile:1
# ARTEX source-development runtime. Production images continue to use Dockerfile.
FROM node:22-bookworm-slim AS node

FROM golang:1.26.3-bookworm

# Keep the backend container useful for agent/tool development as well as for
# compiling Go. Node is copied from the official image so the frontend service
# can reuse this same image without a second toolchain definition.
COPY --from=node /usr/local/ /usr/local/

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git jq make python3 python3-pip ripgrep \
      dnsutils iputils-ping netcat-openbsd nmap \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

EXPOSE 5173 8787 8788

CMD ["bash"]
