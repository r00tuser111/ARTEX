# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 页面一键更新的发布源（owner/name，只能是 GitHub 上的仓库）。留空=官方仓库
# Autumn-27/artex。改它等于让容器执行任意代码，所以页面上改不了，只认这里。
ARTEX_UPDATE_REPO=
# 更新链路专用代理（http/https/socks5）。留空=沿用页面上的全局出口代理。
# 容器内的 127.0.0.1 指容器自己，宿主机代理请用 host.docker.internal。
ARTEX_UPDATE_PROXY=

# 源码开发（dev.sh / docker-compose.dev.yml，可选）
ARTEX_DEV_WEB_PORT=5173
ARTEX_DEV_API_PORT=8787
ARTEX_DEV_PROXY_PORT=8788
ARTEX_DEV_DB_PORT=5432
ARTEX_DEV_DB_USER=artex
ARTEX_DEV_DB_PASSWORD=artex-dev
ARTEX_DEV_DB_NAME=artex
WATCHPACK_POLLING=true
